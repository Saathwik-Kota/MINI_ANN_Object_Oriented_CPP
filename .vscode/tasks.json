{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build miniann_cli (Unified CLI)",
      "type": "shell",
      "command": "C:/msys64/ucrt64/bin/g++.exe",
      "args": [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-Wpedantic",
        "-Werror",
        "-O2",
        "-fopenmp",
        "src/cli_main.cpp",
        "src/NeuralNetwork.cpp",
        "src/Layer.cpp",
        "src/Matrix.cpp",
        "src/Metrics.cpp",
        "src/Neuron.cpp",
        "src/DataLoader.cpp",
        "-I",
        "include",
        "-o",
        "bin/miniann_cli.exe"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
