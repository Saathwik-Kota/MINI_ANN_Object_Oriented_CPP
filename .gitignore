# =====================================================================
# MiniANN Project — Git Ignore Rules
# =====================================================================

# Compiled Executables & Binary Artifacts
bin/
*.exe
*.out
*.app
*.hex

# Intermediate Object Files & Static / Dynamic Libraries
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll

# Build Directories & CMake Cache / Artifacts
build/
build*/
out/
dist/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
Testing/
Makefile

# Compiler, Indexer & Language Server Caches
.cache/
compile_commands.json
*.gcno
*.gcda
*.gcov

# Debugging, Crash & Sanitizer Artifacts
*.dSYM/
*.su
*.idb
*.pdb
*.ilk
*.exp

# Test & Run-Time Ephemeral Outputs
test_tmp_*.csv
*.tmp
*.temp
*.log

# Generated Training Checkpoints (Keep foundational dataset & validated model)
data/cli_model.csv
data/*_temp.csv
data/*.tmp

# OS-Specific Metadata Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Local Settings (Keep workspace configs in .vscode)
.vs/
*.swp
*.swo
*~
.idea/
